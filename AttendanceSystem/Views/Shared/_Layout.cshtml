@using AttendanceSystem.Contracts.Services
@inject IEmployeeService EmployeeService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VasTek Solution Attendance System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Loader")
    @await Html.PartialAsync("_ConfirmModal")

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpg" alt="VasTek Solutions" style="height:32px;border-radius:4px;" />
                    <span>VasTek Attendance</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="navbar-nav me-auto">
                        <a class="nav-link" asp-controller="Attendance" asp-action="Index">Attendance</a>
                        <a class="nav-link" asp-controller="Leave" asp-action="Index">Leaves</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link" asp-controller="Leave" asp-action="Admin">Approve Leaves</a>
                            <a class="nav-link" asp-controller="Admin" asp-action="Employees">Employees</a>
                            <a class="nav-link" asp-controller="Report" asp-action="Index">Reports</a>
                            <a class="nav-link" asp-controller="LeaveBalance" asp-action="Index">Leave Balance</a>
                        }
                    </div>
                    <div class="navbar-nav">
                        @{
                            var currentEmpId = int.Parse(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
                            var currentEmp = EmployeeService.GetById(currentEmpId);
                        }
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(currentEmp?.ProfilePicturePath))
                                {
                                    <img src="@currentEmp.ProfilePicturePath" alt="Profile" class="user-avatar" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="user-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper())</span>
                                }
                                <span>@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">@(User.IsInRole("Admin") ? "Administrator" : "Employee")</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    }

    <div class="container page-content">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">@TempData["Message"]</div>
        }
        @RenderBody()
    </div>

    <footer class="app-footer">
        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-md-3">
                    <img src="~/images/logo.jpg" alt="VasTek Solutions" style="height:36px;border-radius:4px;" class="mb-2" />
                    <p class="small mb-0">An internal system for office attendance, leave management, and monthly reporting.</p>
                </div>
                <div class="col-md-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="mb-2"><a asp-controller="Attendance" asp-action="Index">Attendance</a></li>
                        <li class="mb-2"><a asp-controller="Leave" asp-action="Index">Leaves</a></li>
                        @if (User.Identity != null && User.IsInRole("Admin"))
                        {
                            <li class="mb-2"><a asp-controller="Report" asp-action="Index">Reports</a></li>
                            <li class="mb-2"><a asp-controller="LeaveBalance" asp-action="Index">Leave Balance</a></li>
                        }
                        <li class="mb-2"><a href="https://www.vasteksolutions.com" target="_blank" rel="noopener">VasTek Solutions Website</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Contact</h6>
                    <p class="small mb-1">150-A Block P, Gulberg III, Lahore, Pakistan</p>
                    <p class="small mb-1">Ph: +92 300 8855885</p>
                    <p class="small mb-0">
                        <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=info@vasteksolution.com&amp;su=Attendance%20System%20Support%20Request&amp;body=Hi%20Team%2C%0A%0AI%20am%20facing%20an%20issue%20with%20the%20Attendance%20System.%0A%0ADetails%3A%20"
                           target="_blank" rel="noopener" class="copy-email" data-email="info@vasteksolution.com">info@vasteksolution.com</a>
                    </p>
                </div>
                <div class="col-md-3">
                    <h6>Follow Us</h6>
                    <div class="d-flex gap-3 fs-5">
                        <a href="https://facebook.com/vasteksolutions" target="_blank" rel="noopener" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://linkedin.com/company/vasteksolutions" target="_blank" rel="noopener" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://x.com/vasteksolutions" target="_blank" rel="noopener" title="X"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://instagram.com/vasteksolutions" target="_blank" rel="noopener" title="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom text-center">
            &copy; @DateTime.Now.Year VasTek Solutions. All rights reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>