@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Forgot Password - VasTek Attendance System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="login-page">

    <div class="forgot-password-wrapper">

        <div class="card forgot-password-card">

            <!-- Lock Icon -->
            <div class="forgot-icon">
                🔐
            </div>


            <!-- Heading -->
            <h4 class="forgot-title">
                Forgot Password?
            </h4>


            <!-- Description -->
            <p class="forgot-description">

                If you have forgotten your password, please contact
                the system administrator for assistance.

            </p>


            <!-- Contact Administrator Button -->
            <button type="button"
                    id="showCaptchaBtn"
                    class="btn btn-primary contact-admin-btn">

                Contact Administrator

            </button>


            <!-- CAPTCHA SECTION -->
            <div id="captchaSection"
                 class="captcha-section">

                <div class="captcha-box">

                    <label class="captcha-label">
                        Security Verification
                    </label>


                    <div class="captcha-row">

                        <div id="captchaCode"
                             class="captcha-code">
                        </div>


                        <button type="button"
                                id="refreshCaptcha"
                                class="captcha-refresh"
                                title="Refresh CAPTCHA">

                            ↻

                        </button>

                    </div>


                    <input type="text"
                           id="captchaInput"
                           class="form-control captcha-input"
                           placeholder="Enter CAPTCHA"
                           autocomplete="off"
                           maxlength="6" />


                    <div id="captchaSuccess"
                         class="captcha-success">

                        ✓ Verification successful

                    </div>


                    <div id="captchaError"
                         class="captcha-error">

                        ✕ Incorrect CAPTCHA. Please try again.

                    </div>

                </div>

            </div>


            <!-- ADMINISTRATOR SECTION -->
            <div id="administratorSection"
                 class="administrator-section">


                <!-- Administrator Email -->
                <div class="administrator-box">

                    <div class="administrator-label">
                        Administrator Email
                    </div>

                    <div class="administrator-email">
                        khurram.siddiqi@vasteksolutions.com
                    </div>

                </div>


                <!-- Send Mail -->
                <a id="sendMailBtn"
                   href="#"
                   class="btn btn-primary send-mail-btn">

                    ✉ Send Mail

                </a>


                <!-- Auto Filled Information -->
                <div class="email-info">

                    Clicking <strong>Send Mail</strong> will open your
                    default email application with the recipient,
                    subject, and message automatically filled in.

                </div>

            </div>


            <!-- Back to Login -->
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-secondary back-login-btn">

                Back to Login

            </a>

        </div>

    </div>


    <script src="~/js/site.js"
            asp-append-version="true"></script>

</body>

</html>