@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />
    <title>Login - VasTek Attendance System</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body class="login-page">
    <!-- ONE moving watermark -->
    <div class="floating-watermark">
        VasTek Solutions
    </div>
    @await Html.PartialAsync("_Loader")
    <!-- Login -->
    <div class="login-wrapper">
        <div class="card login-card p-4">
            <div class="text-center mb-2">
                <img src="~/images/logo.jpg" alt="VasTek Solutions" class="login-logo" />
            </div>
            <h4 class="mb-1 text-center">VasTek Attendance System</h4>
            <p class="text-muted text-center small mb-3">
                Sign in to continue
            </p>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }
            <form method="post"
                  asp-controller="Account"
                  asp-action="Login">
                @Html.AntiForgeryToken()
                <!-- Username -->
                <div class="mb-3">
                    <label for="username"
                           class="form-label">
                        Username
                    </label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           autocomplete="username"
                           required />
                </div>
                <!-- Password -->
                <div class="mb-3">
                    <label for="password"
                           class="form-label">
                        Password
                    </label>
                    <div class="password-wrapper">
                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control"
                               autocomplete="current-password"
                               required />
                        <button type="button"
                                id="togglePassword"
                                class="password-toggle"
                                aria-label="Show password">
                            <i id="passwordIcon" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
                <!-- Login -->
                <button type="submit"
                        class="btn btn-primary w-100">
                    Login
                </button>
            </form>
            <div class="text-center mt-2">
                <a asp-controller="Account" asp-action="ForgotPassword" class="small">Forgot password?</a>
            </div>
        </div>
    </div>
 
    <!-- Site JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>
</body>
</html>
