@model Employee

<h4>My Profile</h4>
<div class="card p-4" style="max-width:500px;">
    <form method="post" asp-action="Update" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="text-center mb-3">
            <img src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "/images/logo.jpg" : Model.ProfilePicturePath)"
                 alt="Profile Picture" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" />
        </div>
        <div class="mb-3">
            <label>Profile Picture</label>
            <input type="file" name="profilePicture" class="form-control" accept="image/*" />
        </div>
        <div class="mb-3">
            <label>Full Name</label>
            <input type="text" class="form-control" value="@Model.FullName" disabled />
        </div>
        <div class="mb-3">
            <label>Job Title</label>
            <input type="text" name="jobTitle" class="form-control" value="@Model.JobTitle" placeholder="e.g. Software Engineer" />
        </div>
        <div class="mb-3">
            <label>Role</label>
            <input type="text" class="form-control" value="@Model.Role" disabled />
        </div>
        <button type="submit" class="btn btn-primary w-100">Save Profile</button>
    </form>
</div>