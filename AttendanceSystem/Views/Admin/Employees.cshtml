@model List<Employee>

<h4 id="formTitle">Add New Employee</h4>
<div class="card p-3">
    <form method="post" id="employeeForm"
          action="@Url.Action("Create")"
          data-create-url="@Url.Action("Create")"
          data-update-url="@Url.Action("Update")"
          data-password-url="@Url.Action("GetPassword")"
          class="row g-2" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" id="empId" value="0" />

        <div class="col-md-3">
            <label>Full Name</label>
            <input type="text" name="fullName" id="empFullName" class="form-control" autocomplete="off" required />
        </div>
        <div class="col-md-3">
            <label>Username</label>
            <input type="text" name="username" id="empUsername" class="form-control" autocomplete="off" required />
        </div>
        <div class="col-md-3">
            <label>
                Password
                <small id="passwordHint" class="text-muted d-none">(current password loaded — change if needed)</small>
            </label>
            <div class="input-group">
                <input type="password" name="password" id="newEmpPassword" class="form-control" autocomplete="new-password" required />
                <button class="btn btn-outline-secondary toggle-password" type="button" data-target="newEmpPassword">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
        </div>
        <div class="col-md-2">
            <label>Role</label>
            <select name="role" id="empRole" class="form-control">
                <option value="Employee">Employee</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" id="submitBtn" class="btn btn-primary w-100">Add</button>
        </div>

        <div class="col-md-12" id="cancelWrap" style="display:none;">
            <button type="button" id="cancelEditBtn" class="btn btn-sm btn-outline-secondary mt-1">Cancel edit</button>
        </div>
    </form>
</div>

<h4 class="mt-4">All Employees</h4>
<div class="row g-2 mb-2">
    <div class="col-md-4">
        <input type="text" id="employeeSearch" class="form-control" placeholder="Search by name or username..." />
    </div>
    <div class="col-md-8">
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
            <button type="button" class="btn btn-outline-success" data-filter="active">Active</button>
            <button type="button" class="btn btn-outline-danger" data-filter="inactive">Inactive</button>
        </div>
    </div>
</div>

<table class="table table-bordered table-sm bg-white">
    <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Active</th><th>Action</th></tr></thead>
    <tbody id="employeeTableBody">
        @foreach (var e in Model)
        {
            <tr class="employee-row" data-active="@(e.IsActive ? "active" : "inactive")"
                data-id="@e.EmployeeID"
                data-fullname="@e.FullName"
                data-username="@e.Username"
                data-role="@e.Role">
                <td class="employee-edit-trigger" style="cursor:pointer">@e.FullName</td>
                <td class="employee-edit-trigger" style="cursor:pointer">@e.Username</td>
                <td class="employee-edit-trigger" style="cursor:pointer">@e.Role</td>
                <td>@(e.IsActive ? "Yes" : "No")</td>
                <td>
                    <form method="post" asp-action="ToggleActive" class="d-inline"
                          data-confirm="@(e.IsActive ? $"Deactivate {e.FullName}? They will not be able to log in." : $"Activate {e.FullName}? They will be able to log in again.")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeId" value="@e.EmployeeID" />
                        <input type="hidden" name="isActive" value="@(e.IsActive ? "false" : "true")" />
                        <button type="submit" class="btn btn-sm @(e.IsActive ? "btn-danger" : "btn-success")">
                            @(e.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>