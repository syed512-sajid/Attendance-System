<h3>Welcome, @User.Identity.Name</h3>

<div class="row mt-4 align-items-stretch">
    <div class="col-md-4 d-flex">
        <div class="card w-100 h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Attendance</h5>
                <p class="card-text">View today's check-in and check-out.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Attendance" asp-action="Index">Open</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 d-flex">
        <div class="card w-100 h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Leaves</h5>
                <p class="card-text">Submit a leave request or view your leave status.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Leave" asp-action="Index">Open</a>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4 d-flex">
            <div class="card w-100 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Monthly Report</h5>
                    <p class="card-text">View monthly reports for all employees and export to Excel.</p>
                    <a class="btn btn-primary mt-auto" asp-controller="Report" asp-action="Index">Open</a>
                </div>
            </div>
        </div>
    }
</div>